{
  "name": "reset-pilates-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:clean": "rm -rf .next && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "email:dev": "npx react-email dev --dir emails -p 3010",
    "email:preview": "tsx --tsconfig tsconfig.json scripts/render-email-previews.tsx",
    "email:waitlist-export-prelaunch-preview": "tsx --tsconfig tsconfig.json scripts/preview-waitlist-thank-you-csv.tsx",
    "email:waitlist-thankyou-preview": "tsx --tsconfig tsconfig.json scripts/preview-waitlist-thank-you-csv.tsx",
    "email:waitlist-import": "tsx --tsconfig tsconfig.json scripts/import-waitlist-csv.ts",
    "email:schedule-waitlist-bulk": "tsx --tsconfig tsconfig.json scripts/schedule-waitlist-bulk-send.tsx",
    "email:cancel-scheduled-waitlist": "tsx --tsconfig tsconfig.json scripts/cancel-resend-scheduled-waitlist.tsx",
    "email:intro-offers-test": "tsx --tsconfig tsconfig.json scripts/send-intro-offers-test.tsx",
    "email:schedule-intro-offers-bulk": "tsx --tsconfig tsconfig.json scripts/schedule-intro-offers-bulk-send.tsx",
    "email:send-previews-for-approval": "tsx --tsconfig tsconfig.json scripts/send-template-previews-for-approval.tsx",
    "email:check-resend": "tsx --tsconfig tsconfig.json scripts/resend-list-domains.ts",
    "knockout-paperclip": "node scripts/knockout-paperclip.cjs"
  },
  "dependencies": {
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.0.8",
    "@vercel/blob": "^2.3.3",
