    "lucide-react": "^1.14.0",
    "next": "14.2.35",
    "react": "^18",
    "react-dom": "^18",
    "react-hook-form": "^7.75.0",
    "resend": "^4.8.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@react-email/preview-server": "^4.3.2",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "react-email": "^4.3.2",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.22.0",
    "typescript": "^5"
  }
