# Resend (https://resend.com) — copy to `.env.local` for development.
# In Vercel: Project → Settings → Environment Variables (Production + Preview).

RESEND_API_KEY=re_xxxxxxxx

# Must use a domain you verify in Resend (Domains). Example:
# RESEND_FROM=Reset Pilates <hello@resetpilatesstudio.co.uk>
RESEND_FROM=

# Optional: where enquiries and signups are delivered (defaults to CONTACT.email in code).
# NOTIFY_EMAIL=hello@resetpilatesstudio.co.uk

# Public site URL for email links (optional; defaults to resetpilatesstudio.co.uk in code).
# SITE_URL=https://resetpilatesstudio.co.uk
# NEXT_PUBLIC_SITE_URL=https://resetpilatesstudio.co.uk

# --- Private studio (/studio) — newsletter AI + internal tools ---
# Strong password Mari uses to sign in.
STUDIO_PASSWORD=

# Secret for signing the studio session cookie (min 16 chars; use a long random string).
STUDIO_SESSION_SECRET=

# OpenAI for “Newsletter from notes” on /studio/newsletter
OPENAI_API_KEY=
# Optional override (default gpt-4o-mini)
# NEWSLETTER_OPENAI_MODEL=gpt-4o-mini

# When Momence (or your booking tool) can POST here, sends the welcome-booking template.
# BOOKING_WEBHOOK_SECRET=
