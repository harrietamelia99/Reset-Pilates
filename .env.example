# =============================================================================
# Local: copy this file to `.env.local` in the project root, then fill in values.
#       Never commit `.env.local` (it is gitignored).
# Production: add the same keys in Vercel → Project → Settings → Environment
#             Variables, then redeploy.
# =============================================================================

# --- Resend (contact form + homepage/promo email alerts) ---
# https://resend.com — API key from dashboard; RESEND_FROM must be a verified domain sender.
# Alerts: notifies NOTIFY_EMAIL (or CONTACT email) AND sends a branded confirmation to the subscriber.
# Never put a real API key in this file (it may be committed). Paste your key only in `.env.local`.

RESEND_API_KEY=
RESEND_FROM=Reset Pilates <hello@resetpilatesstudio.co.uk>

# Optional. Where form submissions are delivered (defaults to hello@resetpilatesstudio.co.uk).
NOTIFY_EMAIL=

# Studio “Send to everyone on the list”: Resend Audience ID (Dashboard → Audiences, or Segment ID if migrated).
RESEND_STUDIO_BROADCAST_AUDIENCE_ID=

# Optional. Confirmation word for that button (default SEND). Must match what you set on the server if you change it.
# STUDIO_BROADCAST_CONFIRM_PHRASE=

# --- Momence booking (public iframe on /book; optional override) ---
# Default in code is the studio Momence storefront. Set this only when you switch to a new embed URL.
# NEXT_PUBLIC_MOMENCE_SCHEDULE_URL=https://momence.com/u/your-studio-slug
NEXT_PUBLIC_MOMENCE_SCHEDULE_URL=

# --- Site URL (optional; used in email templates / links) ---
SITE_URL=
NEXT_PUBLIC_SITE_URL=

# Optional. Base URL for email <img> files under /public/brand (defaults same as SITE_URL above).
# Use http://localhost:3000 while `next dev` is running so React Email preview can load header + icons.
EMAIL_ASSET_BASE_URL=

# --- Private studio at /studio (optional until you use that area) ---
# Do not put real values here — this file may be committed. Use Vercel env + `.env.local` only.
STUDIO_PASSWORD=
STUDIO_SESSION_SECRET=

# --- OpenAI (optional; only for /studio/newsletter AI draft) ---
OPENAI_API_KEY=
NEWSLETTER_OPENAI_MODEL=

# --- Vercel Blob (photo uploads for /studio/newsletter on production) ---
# https://vercel.com/docs/storage/vercel-blob — add read-write token in Vercel + .env.local for production uploads.
# Local dev can skip this; images are stored under public/newsletter-media/ instead.
BLOB_READ_WRITE_TOKEN=

# --- Momence Public API (optional; server-side only — never NEXT_PUBLIC_*) ---
# Dashboard: create a Public API client → https://momence.com/dashboard/profile?host-redirect=public-api-clients
# Docs: https://api.docs.momence.com/docs/getting-started
# Tokens expire in a few hours; use refresh flow or re-auth for anything long-running.
MOMENCE_CLIENT_ID=
MOMENCE_CLIENT_SECRET=
MOMENCE_ACCESS_TOKEN=
MOMENCE_REFRESH_TOKEN=
# Optional. Default is https://api.momence.com (see OpenAPI: https://static.momence.com/schema/api-v2-schema.yaml)
# MOMENCE_API_BASE_URL=
# If you only stored one bearer under a short name, this is read the same as MOMENCE_ACCESS_TOKEN:
# MOMENCE_TOKEN=

# --- Momence Primary API (site list endpoints — different from OAuth Public API above) ---
# GET https://momence.com/_api/primary/api/v1/{Events|Videos|Memberships|Products|Teachers}?hostId=…&token=…
# Use the host id + site token from your Momence integration docs (server-only — never NEXT_PUBLIC_*).
MOMENCE_HOST_ID=
MOMENCE_PRIMARY_SITE_TOKEN=
# Alias for MOMENCE_PRIMARY_SITE_TOKEN only:
# MOMENCE_SITE_TOKEN=
# Optional base override (defaults to Momence Primary v1 URL above)
# MOMENCE_PRIMARY_API_BASE=

# --- Booking webhook (optional; call from Momence or another provider when they support webhooks) ---
# Your app: POST /api/webhooks/booking with header x-reset-booking-secret: <same value>
BOOKING_WEBHOOK_SECRET=
