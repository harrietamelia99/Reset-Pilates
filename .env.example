# =============================================================================
# Local: copy this file to `.env.local` in the project root, then fill in values.
#       Never commit `.env.local` (it is gitignored).
# Production: add the same keys in Vercel → Project → Settings → Environment
#             Variables, then redeploy.
# =============================================================================

# --- Resend (contact form + homepage/promo email alerts) ---
# https://resend.com — API key from dashboard; RESEND_FROM must be a verified domain sender.
# Alerts: notifies NOTIFY_EMAIL (or CONTACT email) AND sends a branded confirmation to the subscriber.
# Never put a real API key in this file (it may be committed). Paste your key only in `.env.local`.

RESEND_API_KEY=
RESEND_FROM=Reset Pilates <hello@resetpilatesstudio.co.uk>

# Optional. Where form submissions are delivered (defaults to hello@resetpilatesstudio.co.uk).
NOTIFY_EMAIL=

# --- Site URL (optional; used in email templates / links) ---
SITE_URL=
NEXT_PUBLIC_SITE_URL=

# Optional. Base URL for email <img> files under /public/brand (defaults same as SITE_URL above).
# Use http://localhost:3000 while `next dev` is running so React Email preview can load header + icons.
EMAIL_ASSET_BASE_URL=

# --- Private studio at /studio (optional until you use that area) ---
STUDIO_PASSWORD=
STUDIO_SESSION_SECRET=

# --- OpenAI (optional; only for /studio/newsletter AI draft) ---
OPENAI_API_KEY=
NEWSLETTER_OPENAI_MODEL=

# --- Vercel Blob (photo uploads for /studio/newsletter on production) ---
# https://vercel.com/docs/storage/vercel-blob — add read-write token in Vercel + .env.local for production uploads.
# Local dev can skip this; images are stored under public/newsletter-media/ instead.
BLOB_READ_WRITE_TOKEN=

# --- Booking webhook (optional; Momence etc. when ready) ---
BOOKING_WEBHOOK_SECRET=
